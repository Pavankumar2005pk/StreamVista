{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "env": {
    "REACT_APP_TMDB_BEARER": "eyJhbGciOiJIUzI1NiJ9.eyJhdWQiOiIwODUzZjc0MWNiODhjZjE0MjE4ZjI1NWZhNzBjZjIyNyIsIm5iZiI6MTc2MDQxMjE1Mi41OTUsInN1YiI6IjY4ZWRjMWY4ZDJjMGJmNWZlN2YxMWZiYiIsInNjb3BlcyI6WyJhcGlfcmVhZCJdLCJ2ZXJzaW9uIjoxfQ.fqWH96uuv2qWhnHOJG5vYjukLDaLX2QN1bml-VM3xMs",
    "REACT_APP_TMDB_BASE_URL": "https://api.themoviedb.org/3"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    },
    {
      "src": "/service-worker.js",
      "dest": "/service-worker.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/logo192.png",
      "dest": "/logo192.png"
    },
    {
      "src": "/logo512.png",
      "dest": "/logo512.png"
    },
    {
      "src": "^/(.*)",
      "dest": "/index.html"
    }
  ]
}
